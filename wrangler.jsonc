{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amooamir",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0f37b0b2-493a-4c83-be6e-2f2b2937d7c6","database_name": "nova-d0b334-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "933eb8490f0140d3b598c3e6228aae04" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
